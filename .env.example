# Base URL of the Monsef Python (RAG) backend.
# Flask dev server (PORT in the backend's .env).
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Serve the ruling generator and the contract templates from local mock data
# instead of the Python backend. Laws and precedents ignore this — both are
# wired to live Flask endpoints.
NEXT_PUBLIC_USE_MOCKS=false
