# Base URL of the Monsef Python (RAG) backend.
# Placeholder — FastAPI's default port. Change once the real API is deployed.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Serve the ruling generator (and later features) from local mock data instead
# of the Python backend. Set to "false" once the API is live.
NEXT_PUBLIC_USE_MOCKS=true
